BPCL_DB_URL=postgres://bpcl:CHANGE_ME@db:5432/bpcl_portal?sslmode=require
BPCL_JWT_SECRET=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
BPCL_JWT_EXPIRY=8h
BPCL_PORT=8080
BPCL_UPLOAD_DIR=/app/uploads
BPCL_CORS_ORIGINS=https://yourdomain.com
BPCL_MAX_UPLOAD_MB=10
BPCL_LOG_LEVEL=info
BPCL_ENV=production
BPCL_RATE_LIMIT_RPM=60