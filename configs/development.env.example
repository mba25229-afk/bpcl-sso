BPCL_DB_URL=postgres://bpcl:bpcl@localhost:5433/bpcl_portal?sslmode=disable
BPCL_JWT_SECRET=dev-secret-change-in-production-min-32-chars
BPCL_JWT_EXPIRY=24h
BPCL_PORT=8080
BPCL_UPLOAD_DIR=/tmp/bpcl-uploads
BPCL_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
BPCL_MAX_UPLOAD_MB=10
BPCL_LOG_LEVEL=debug
BPCL_ENV=development
BPCL_RATE_LIMIT_RPM=100